# ─────────────────────────────────────────────────────────────────────────────
# AI Pace — configuration. Copy to .env and adjust. Everything is optional except
# the providers you want to track. `npm run check` tests it without starting the server.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=8787
# How often to fetch data from the providers (minutes)
REFRESH_MINUTES=15
# Deviation (percentage points) still considered "on pace"
PACE_TOLERANCE=5
# Token used by the clients (web, iPhone, Mac). Empty = generated and saved in data/state.json
# (print it with `npm run token`).
API_TOKEN=
# Public URL used in links (e.g. https://my-pi.tailXXXX.ts.net). Empty = derived from the request.
PUBLIC_URL=
DATA_DIR=./data
# Number, money and date format for server-generated text (e.g. en-US, en-GB, pt-BR, de-DE)
LOCALE=en-US

# ── Claude (Pro/Max subscription: 5-hour session and weekly limits) ──────────
# auto = on if the credentials file exists
CLAUDE_ENABLED=auto
# shared    = reuse your everyday Claude Code login (~/.claude/.credentials.json), read-only.
#             Simple, but stops updating when the token expires and you're not using Claude Code.
# dedicated = a login just for this server, refreshed automatically 24/7. Create it with:
#             CLAUDE_CONFIG_DIR=~/.config/ai-pace/claude claude auth login
#             and set CLAUDE_CREDENTIALS_FILE=~/.config/ai-pace/claude/.credentials.json
CLAUDE_TOKEN_MODE=shared
CLAUDE_CREDENTIALS_FILE=~/.claude/.credentials.json

# ── OpenAI (Codex limits on a ChatGPT plan: 5-hour session and weekly limits) ─
OPENAI_ENABLED=auto
# Same idea as Claude. Dedicated login:
#             CODEX_HOME=~/.config/ai-pace/codex codex login
#             and set CODEX_AUTH_FILE=~/.config/ai-pace/codex/auth.json
CODEX_TOKEN_MODE=shared
CODEX_AUTH_FILE=~/.codex/auth.json

# ── Gemini / Google Cloud credits (e.g. $1000 to spend in 3 months) ──────────
# Set the total to turn it on. Copy the values from console.cloud.google.com/billing → Credits.
GEMINI_CREDIT_TOTAL=
GEMINI_CREDIT_CURRENCY=USD
# Display name for the credit (optional)
GEMINI_CREDIT_NAME=
# Date the credit started
GEMINI_CREDIT_START=
# End: exact date OR duration in months from the start
GEMINI_CREDIT_END=
GEMINI_CREDIT_MONTHS=3
# Warn this many days before the credit expires (time to request more)
GEMINI_RENEW_DAYS=15

# Manual mode (no automatic source): amount already used. You can update it later from the dashboard.
GEMINI_CREDIT_USED=

# Automatic mode (recommended): Cloud Billing budget notifications via Pub/Sub.
# `npm run setup:gcp` (scripts/setup-gcp-budget.sh) creates everything and prints these values.
GCP_PUBSUB_SUBSCRIPTION=
GCP_BUDGET_SINCE=
# Key of the read-only service account the setup script creates (shared with the BigQuery mode)
GCP_SERVICE_ACCOUNT_FILE=

# Alternative automatic mode: Cloud Billing export to BigQuery (see the README)
GCP_BILLING_TABLE=
# (instead of GCP_SERVICE_ACCOUNT_FILE: the whole key JSON, raw or base64)
GCP_SERVICE_ACCOUNT_JSON=
# Only count these projects (comma separated). Empty = the whole billing account.
GCP_BILLING_PROJECTS=
# credits = promotional credits consumed | cost = gross cost
GCP_CREDIT_MEASURE=credits
GCP_CREDIT_TYPES=PROMOTION
# Credits already used before automatic tracking started (the setup script computes it)
GEMINI_CREDIT_USED_OFFSET=0
